@model Ticketa.Web.ViewModels.TableSkeletonVM
@{
  var widths = new[] { "w-full", "w-3/4", "w-1/2", "w-2/3", "w-4/5", "w-3/5" };
}
@for (var i = 0; i < Model.RowCount; i++)
{
  <tr class="animate-pulse">
    @for (var j = 0; j < Model.ColumnCount; j++)
    {
      <td>
        @if (Model.FirstColumnImage && j == 0)
        {
          <div class="h-12 w-9 rounded-lg bg-base-300"></div>
        }
        else
        {
          <div class="h-4 rounded-md bg-base-300 @widths[(i + j) % widths.Length]"></div>
        }
      </td>
    }
  </tr>
}
